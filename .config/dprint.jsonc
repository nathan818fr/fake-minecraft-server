{
  "lineWidth": 80,
  "markdown": {
    "textWrap": "maintain",
    // Keep code blocks as written, such as their aligned comments.
    "codeBlock.skipFormat": true
  },
  "yaml": {
    "printWidth": 120
  },
  "dockerfile": {
    "associations": ["Containerfile"]
  },
  "ruff": {
    "lineLength": 120
  },
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.26.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/toml-0.9.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.7.0.wasm",
    "https://plugins.dprint.dev/ruff-0.11.1.wasm"
  ]
}
